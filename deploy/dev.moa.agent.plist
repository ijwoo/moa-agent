<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 맥에 로그인하면 에이전트 서버를 띄우고, 죽으면 다시 띄운다(D81). 설치: scripts/install_autostart.sh · 지우기: scripts/install_autostart.sh remove -->
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.moa.agent</string>
  <key>ProgramArguments</key>
  <array><string>/bin/zsh</string><string>__REPO__/scripts/start_server.sh</string></array>
  <key>WorkingDirectory</key><string>__REPO__</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>AbandonProcessGroup</key><true/>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>__LOGS__/server.log</string>
  <key>StandardErrorPath</key><string>__LOGS__/server.log</string>
</dict>
</plist>
