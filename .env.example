# 모델 제공자: qwen (Phase 1은 qwen만 구현됨)
MODEL_PROVIDER=qwen

# Ollama 서버 주소와 모델 이름
OLLAMA_HOST=http://127.0.0.1:11434
QWEN_MODEL=qwen3:8b

# 도구 호출 방식: json(기본, D11) | native. thinking: 0(기본, D12) | 1
QWEN_TOOL_MODE=json
QWEN_THINK=0

# navigate 허용 호스트 (쉼표 구분, 비어 있으면 모두 거부)
ALLOWED_HOSTS=

# 요청 타임아웃(초)
MODEL_TIMEOUT=120

# 아래 설정은 이후 Phase에서 사용 (MODEL_PROVIDER와 서로 독립)
# SANDBOX_BACKEND=docker
# AGENT_MODE=observe

# Claude 비교용 (D34). 이 프로젝트 전용 키를 콘솔에서 만들어 실제 .env에만 넣는다(.env는 git 제외). 사용 한도 설정 권장.
# 대화 판단을 Claude가(D59). 켜려면 아래 둘을 쓴다. 키가 없거나 부르지 못하면 로컬 판단으로 돌아간다.
# DIALOG_HEAD=claude            # 기본 local
# DIALOG_MODEL=claude-sonnet-5-5 # 사용자가 고른 모델 id
# DIALOG_SEND_CONTEXT=1         # 0이면 회의 자료의 내용을 Claude에 보내지 않는다(붙어 있다는 사실만)
# DIALOG_WEB_SEARCH=1           # 공개 정보(날씨·가격·운영 시간)를 Claude의 웹 검색으로 찾는다(기본 꺼짐, D60). 검색 물음 한 문장만 나간다
# DIALOG_WEB_FIND=1             # "찾아 달라"는 말은 맥의 브라우저가 공개 페이지를 직접 열어 읽고 링크·대표 그림과 함께 답한다(D61, 기본 꺼짐)
# DIALOG_SHOP_DRIVE=1           # 쇼핑(D68): 살 것을 찾는 말을 작업으로 — 폰의 앱 안 쇼핑 화면이 검색·상품 화면을 열어 읽고, 맥이 정리한다(기본 꺼짐).
#                               #   맥은 쇼핑 사이트에 접속하지 않는다. 폰은 열기만 하고 누르지 않는다
# DIALOG_WEB_BROWSE=1           # 일반 길(D67): 정해진 기능에 없는 부탁은 맥의 브라우저가 공개 사이트에서 스스로 해 본다(기본 꺼짐).
#                               #   공개 페이지의 화면 글이 운전하는 Claude로 간다. 로그인 없는 브라우저, 바꾸는 동작은 하지 않는다
# DIALOG_BROWSE_MODEL=claude-haiku-5-5   # 운전 모델(측정: haiku 과제당 몇 원·4~27초, sonnet은 어려운 조회 화면에 강하지만 백 배쯤 비싸다)
# DIALOG_WEB_FIND_READER=search # 찾은 답을 누가 쓰나: search(검색이 쓴 답 + 연 페이지의 링크·그림, 기본·측정상 가장 정확) | local(연 페이지를 로컬 모델이 읽음, 느림)
#                               #   | claude(연 페이지의 글을 Claude가 읽음 — 공개 페이지 글이 Claude로 간다. 사용자가 정했을 때만)
# NAVER_SEARCH_ID=              # (선택) 네이버 검색 API 키 — 쇼핑 검색(DIALOG_SHOP_API=1)에 쓴다. DIALOG_WEB_FIND_FINDER=naver도 켜면 찾기의 후보 페이지도 네이버로 찾는다.
# NAVER_SEARCH_SECRET=          #        developers.naver.com → 애플리케이션 등록 → "검색" API. 값은 여기에만 넣는다
# DIALOG_WEB_MODEL=claude-haiku-5-5  # 검색 답을 쓰는 모델(없으면 DIALOG_MODEL). 측정: 한 번에 sonnet 약 $0.05·5~6초, haiku 약 $0.012·3초대(글이 조금 거칠다)
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5

# 앱용 API (D40). 처음 `agent.cli serve`를 실행하면 실제 .env에 자동 생성된다. 커밋 금지.
# AGENT_APP_TOKEN=
# QWEN_MODEL=qwen3:14b
# AGENT_THINK=1
# AGENT_USER_ID=app

# 본인 주소 발송 (D50·D51). 계정은 보통 앱의 "메일 계정 연결"에서 주소와 앱 비밀번호를 넣어 등록한다 — 아래는 선택 사항.
# SEND_SELF_ADDRESSES: 미리 적어 둘 본인 주소(쉼표 구분). 실제 주소는 실제 .env에만(커밋 금지). 앱 비밀번호는 여기 넣지 않는다.
# SEND_SELF_SYNTHETIC=1: 서버 안의 합성 메일 서버를 켠다(@mail.test 주소, 외부 발송 없음, 앱 연동 시험용).
# SEND_SELF_ADDRESSES=
# SEND_SELF_SYNTHETIC=0
# SEND_OTHERS=1: 다른 사람에게도 보낸다(D77). 받는 사람은 연락처·사용자가 대화에 직접 친 주소만, 보낼 때마다 승인 카드. 0이면 본인 주소로만.
# SEND_OTHERS=0

# 보고의 화면 캡처(D58): 1이면 작업 보고에 읽은 화면·멈춘 화면을 붙인다(result.report.attachments). 캡처는 서버 메모리에만 둔다.
# REPORT_ATTACHMENTS=0

# 푸시 알림(D44, docs/design/push.md). 아래 셋과 키체인의 키가 다 있을 때만 켜진다(features에 push).
#   키(.p8)의 내용은 여기에 넣지 않는다 — 키체인에: security add-generic-password -U -s local-ai-agent.apns -a apns-p8 -w "$(cat <.p8 경로>)"
# APNS_KEY_ID=                  # 키 이름(AuthKey_<이 값>.p8)
# APNS_TEAM_ID=                 # 개발자 계정의 팀 ID
# APNS_TOPIC=                   # 앱의 번들 ID
# PUBLIC_BROWSER_HEADED=1       # 공개 길(찾기·일반 길)의 브라우저를 컨테이너 안 가상 화면에 창 있는 모드로 띄운다(D69). 창 없는 모드는 HeadlessChrome이라고 밝혀 여러 사이트가 403으로 거른다. 자동화 표시는 그대로 둔다. 로그인하는 사이트 흐름에는 쓰지 않는다(기본 꺼짐).
# DIALOG_SHOP_VIEW=0            # 폰의 앱 안 쇼핑 화면을 여는 1단계(action shop, D66)를 끈다(기본 켬). DIALOG_SHOP_DRIVE와 함께 끄면 살 것을 찾는 말에 폰의 쇼핑 화면이 열리지 않는다.
# DIALOG_SHOP_API=1             # (쓰지 않는다) 네이버 쇼핑 검색 API는 2026-07-31에 종료됐다(D71 고침). 코드는 다른 상품 검색 원천이 생기면 쓰려고 남겨 뒀다.
# DIALOG_WEB_FIND_FINDER=naver  # 찾기(D61)의 후보 페이지를 네이버 검색 API로(키 필요, 미확인). 없으면 Claude의 웹 검색.
# DIALOG_SITE_DO=1              # 로그인한 사이트 안에서 하기(D72): 공통 로그인으로 로그인해 둔 사이트 안에서 말한 일을 한다. 화면은 Claude(DIALOG_BROWSE_MODEL)가 본다 — 사이트마다 사용자의 허락을 질문 카드로 묻는다. 바꾸는 동작은 승인 카드(기본 꺼짐).
# ROUTINES=1: 예약해 둔 일(루틴, D80) — 정한 때에 정한 말을 대신 건넨다(대화 판단이 Claude일 때만). 바꾸는 일은 그때도 승인에서 멈춘다. 0이면 예약이 없다.
# ROUTINES=0

# 받은 메일을 Claude가 읽고 브리핑·이어지는 물음에 답한다(D82). 보낸 사람·제목·본문 앞부분이 Claude로 간다. 0이면 맥의 로컬 모델만
MAIL_CLOUD=0

# 내 공간(D87): 말로 짜는 카드 화면(/v1/space). 구성은 Claude가 내고 코드가 검사한다. 대화 판단이 Claude일 때만
SPACE=0

# 로그인이 풀린 사이트에, 사용자가 처음 고른 소셜 로그인(네이버 등)으로 스스로 다시 들어간다(D90). 그 회사의 단추만 누른다 — 아이디·비밀번호는 쓰지 않고, 더 물으면 그만둔다
SITE_AUTO_RELOGIN=0

# 작업실(D96): 1이면 "만들어줘" 부탁을 격리된 컨테이너에서 Claude가 코드를 짜서 만든다(docker/workroom 이미지 필요)
WORKROOM=0
# WORKROOM_MODEL=claude-sonnet-5-5
# WORKROOM_MAX_USD=5
